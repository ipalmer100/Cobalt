# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
backend/.venv/

# Node / frontend
frontend/node_modules/
frontend/dist/

# PyInstaller build output for the packaged desktop app
packaging/build/
packaging/dist/
packaging/.build-venv/
/build/
/dist/

# Real spec documents are customer data — never commit these.
# (synthetic fixtures used by the test suite are generated at test time,
# see backend/tests/fixtures/builder.py)
*.docx
*.doc
local_fixtures/

# Exception: the app's own synthetic "New Spec" template — no customer
# data, generated by backend/scripts/build_blank_template.py.
!backend/cobalt/templates/*.docx
